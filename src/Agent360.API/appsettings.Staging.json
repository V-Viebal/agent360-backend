{
  "$comment": "Staging environment configuration. Depending on the software lifecycle stage, teams can toggle Serilog:MinimumLevel:Default between Debug (for deep diagnostics in staging-first workflows without dedicated dev servers) and Information (for high-volume pre-production smoke testing).",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "Microsoft.AspNetCore.Routing": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{Application}] [{SourceContext}]{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logto": {
    "OpenAPIRedirectUri": ""
  }
}
