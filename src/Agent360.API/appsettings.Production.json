{
  "RuntimeConfiguration": {
    "Validate": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{Application}] [{SourceContext}]{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "_logs/prod/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": false,
          "buffered": true,
          "flushToDiskInterval": "00:00:05",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{Application}] [{SourceContext}]{NewLine}{Message:lj}{NewLine}{Exception}{NewLine}"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://agent360.antares.vn",
      "https://community-agent360.antares.vn",
      "https://skyer.hmz.one",
      "https://community.skyer.hmz.one"
    ]
  },
  "Logto": {
    "Authority": "https://auth-skyer.hmz.one/oidc",
    "Audience": "https://api-skyer.hmz.one",
    "OpenAPIRedirectUri": "https://api-skyer.hmz.one/scalar/v1"
  },
  "Storage": {
    "Provider": "Minio",
    "ServerUrl": "https://s3-skyer.hmz.one",
    "AccessKey": "admin",
    "SecretKey": "agent360_minio_secure_s3_2026",
    "BucketName": "agent360-production",
    "UseSsl": true
  }
}
