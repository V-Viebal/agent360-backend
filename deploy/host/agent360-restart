#!/bin/bash
# Narrow deploy hook for the GitHub runner (sudo): apply one Agent360 surface and fail loudly if it did not apply.
#   backend | backend-staging   -> recreate when backend.env changed, else restart; wait for "Now listening"
#   frontend | frontend-staging -> install nginx conf from the CI checkout when given, nginx -t, reload only on change
set -euo pipefail
wait_backend() {
  local c=$1
  for i in $(seq 1 60); do sleep 2; docker exec "$c" sh -c "exit 0" 2>/dev/null && docker logs --since 2m "$c" 2>&1 | grep -q "Now listening" && { echo "$c up"; return 0; }; done
  echo "$c not ready" >&2; return 1
}
apply_backend() { # $1 container $2 compose dir $3 compose file $4 env file
  local c=$1 dir=$2 file=$3 env=$4 stamp; stamp="$(dirname "$env")/.backend.env.applied"
  local envsum; envsum=$(sha256sum "$env" | cut -c1-16)
  if [ "$(cat "$stamp" 2>/dev/null)" != "$envsum" ]; then
    # Code is bind-mounted at /app; the image is only the .NET runtime, so never pull (pull_policy: never).
    (cd "$dir" && docker compose -f "$file" up -d --no-deps --force-recreate --pull never "$c") \
      || { echo "recreate of $c failed; env NOT applied" >&2; exit 1; }
    echo "$envsum" > "$stamp"; echo "$c recreated (env changed)"
  else
    docker restart "$c" >/dev/null
  fi
  wait_backend "$c"
}
apply_frontend() { # $1 container $2 conf dir $3 optional conf source from the CI checkout
  local c=$1 dir=$2 src=${3:-} stamp="$2/.applied"
  if [ -n "$src" ]; then
    case "$(readlink -f "$src")" in
      /opt/actions-runner-shared-2nd/_work/agent360-frontend/*/deploy/nginx/*.conf) ;;
      *) echo "refusing conf outside the agent360-frontend CI checkout: $src" >&2; exit 2 ;;
    esac
    install -m 0644 "$src" "$dir/default.conf.next"
    mv -f "$dir/default.conf.next" "$dir/default.conf"   # directory is mounted, so a rename is picked up
  fi
  local confsum; confsum=$(sha256sum "$dir/default.conf" | cut -c1-16)
  # Static assets are bind-mounted and served fresh. Reloading drains workers and cuts SSE chats: only on change.
  if [ "$(cat "$stamp" 2>/dev/null)" != "$confsum" ]; then
    docker exec "$c" nginx -t
    docker exec "$c" nginx -s reload
    echo "$confsum" > "$stamp"; echo "$c reloaded (config changed)"
  else
    echo "$c assets published (no reload needed)"
  fi
}
exec 9>/run/lock/agent360-deploy.lock
flock -w 300 9 || { echo "another agent360 deploy holds the lock" >&2; exit 75; }
case "${1:-}" in
  backend)          apply_backend agent360-backend /opt/agent360/deploy docker-compose.prod.yml /opt/agent360/deploy/backend.env ;;
  backend-staging)  apply_backend agent360-backend-staging /opt/agent360-staging docker-compose.yml /opt/agent360-staging/deploy/backend.env ;;
  frontend)         apply_frontend agent360-frontend /opt/agent360/nginx-conf "${2:-}" ;;
  frontend-staging) apply_frontend agent360-frontend-staging /opt/agent360-staging/nginx-conf "${2:-}" ;;
  *) echo "usage: agent360-restart backend|backend-staging|frontend [conf]|frontend-staging [conf]" >&2; exit 2 ;;
esac
